{
  "name": "frontend-system-design-course",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --no-warnings --experimental-sqlite course/server.mjs",
    "seed": "npm run seed:roadmap && npm run seed:questions && npm run seed:practice",
    "seed:roadmap": "node --no-warnings --experimental-sqlite course/seed.mjs",
    "seed:questions": "node --no-warnings --experimental-sqlite course/seed-questions.mjs",
    "seed:practice": "node --no-warnings --experimental-sqlite course/seed-practice.mjs",
    "course": "node --no-warnings --experimental-sqlite course/cli.mjs",
    "icons": "node course/make-icons.mjs",
    "practice": "node --no-warnings --experimental-strip-types --test \"practice/**/*.test.ts\""
  }
}
